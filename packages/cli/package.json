{
  "name": "balchemy",
  "version": "0.9.0",
  "license": "MIT",
  "type": "module",
  "description": "Run a local Balchemy trading agent on Solana from a chat cockpit in your terminal",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "balchemy": "dist/index.js",
    "create-balchemy-agent": "dist/index.js",
    "balchemy-agent": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.spec.d.ts",
    "!dist/**/*.spec.d.ts.map",
    "!dist/**/*.spec.js",
    "!dist/**/*.spec.js.map",
    "!dist/**/*.map",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "balchemy",
    "ai-agent",
    "crypto",
    "trading",
    "solana",
    "cli"
  ],
  "homepage": "https://balchemy.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/balchemy/balchemy-agent.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/balchemy/balchemy-agent/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@balchemyai/agent-rules": "^1.2.0",
    "@balchemyai/agent-sdk": "^0.9.0",
    "@inkjs/ui": "^2.0.0",
    "dotenv": "^16.0.0",
    "fs-native-extensions": "1.4.3",
    "ink": "^6.0.0",
    "js-yaml": "^4.1.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "22.17.2",
    "@types/react": "^19.0.0",
    "typescript": "5.8.3"
  },
  "scripts": {
    "build": "pnpm --dir ../sdk build && node scripts/clean-dist.cjs && tsc -p tsconfig.build.json && node scripts/ensure-bin-executable.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm --dir ../sdk build && node scripts/clean-dist.cjs && tsc -p tsconfig.json && find dist \\( -path '*/__tests__/*.spec.js' -o -path '*/__tests__/*.test.js' \\) -print | sort | xargs node --test && pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm run build"
  }
}
