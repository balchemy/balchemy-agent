{
  "name": "balchemy",
  "version": "0.3.5",
  "license": "MIT",
  "type": "module",
  "description": "Scaffold and run a local Balchemy MCP agent client",
  "main": "dist/index.js",
  "bin": {
    "balchemy": "dist/index.js",
    "create-balchemy-agent": "dist/index.js",
    "balchemy-agent": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.spec.d.ts",
    "!dist/**/*.spec.d.ts.map",
    "!dist/**/*.spec.js",
    "!dist/**/*.spec.js.map",
    "assets",
    "templates",
    "README.md"
  ],
  "keywords": [
    "balchemy",
    "ai-agent",
    "crypto",
    "trading",
    "mcp",
    "solana",
    "cli"
  ],
  "homepage": "https://balchemy.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/balchemy/balchemy-agent.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/balchemy/balchemy-agent/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@balchemyai/agent-sdk": "^0.3.5",
    "@inkjs/ui": "^2.0.0",
    "dotenv": "^16.0.0",
    "ink": "^6.0.0",
    "js-yaml": "^4.1.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "22.17.2",
    "@types/react": "^19.0.0",
    "typescript": "5.8.3"
  },
  "scripts": {
    "build": "pnpm --dir ../sdk build && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm run build && find dist \\( -path '*/__tests__/*.spec.js' -o -path '*/__tests__/*.test.js' \\) -print | sort | xargs node --test",
    "prepublishOnly": "pnpm run typecheck && pnpm run build"
  }
}
